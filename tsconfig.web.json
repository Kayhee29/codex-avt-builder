{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo",

    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "jsx": "react-jsx",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,

    // `src/shared/` uses `.ts` extensions in relative imports so the same
    // files also run under Node's native TypeScript support
    // (see `scripts/export-schemas.ts`).
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/*"],
      "@shared/*": ["src/shared/*"]
    }
  },
  // The renderer's own tests are part of this project rather than a fourth
  // one: they are `.tsx`, they render React and they need the DOM lib, and
  // `tsconfig.node.json` only ever matched `tests/**/*.ts` (plan Task 5.1).
  // `tsconfig.node.json` excludes the same directory, so every test file is
  // checked exactly once.
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/shared/**/*.ts",
    "tests/unit/renderer/**/*.ts",
    "tests/unit/renderer/**/*.tsx"
  ]
}
