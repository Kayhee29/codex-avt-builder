# Dependencies
node_modules/

# Build output
out/
dist/
.vite/
*.tsbuildinfo

# Test and tooling caches
coverage/
.eslintcache
playwright-report/
test-results/

# Runtime workspace data (spec section 9).
# Drafts, jobs and every generated or copied image are local runtime data.
workspace/drafts/
workspace/jobs/
# Holds the machine-specific Codex executable override (plan Task 3.1).
workspace/settings.json
workspace/**/*.png
workspace/**/*.jpg
workspace/**/*.jpeg
workspace/**/*.webp

# Preset and anchor metadata stay trackable:
!workspace/presets/**/*.json
!workspace/anchors/**/*.json

# Editor and OS noise
.DS_Store
Thumbs.db
*.local
