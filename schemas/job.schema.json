{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JobPacket",
  "description": "job.json, the immutable contract between the UI builder and the Codex CLI (spec section 6). Written once and carrying no run state.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "jobId": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9](?:[a-z0-9-]{0,22}[a-z0-9])?-\\d{3}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "executor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "codex-cli"
        },
        "minimumVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "imageTool": {
          "type": "string",
          "const": "image_gen"
        }
      },
      "required": [
        "kind",
        "minimumVersion",
        "imageTool"
      ],
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "pose": {
          "type": "string"
        },
        "expression": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "additionalProperties": false
    },
    "references": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "enum": [
              "Image A",
              "Image B",
              "Image C",
              "Image D",
              "Image E"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "style",
              "identity",
              "outfit",
              "equipment",
              "extra"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^inputs\\/(style|identity|outfit|equipment|extra)\\.(png|jpg|webp)$"
          },
          "originalName": {
            "type": "string",
            "minLength": 1
          },
          "mimeType": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp"
            ]
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "role",
          "path",
          "originalName",
          "mimeType",
          "sizeBytes",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "aspectRatio": {
          "type": "string",
          "minLength": 1
        },
        "background": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": [
            "png",
            "jpg",
            "webp"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "aspectRatio",
        "background",
        "format",
        "count"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "preset": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "anchor": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "preset",
        "anchor"
      ],
      "additionalProperties": false
    },
    "promptPath": {
      "type": "string",
      "const": "prompt.md"
    },
    "promptSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "jobId",
    "createdAt",
    "executor",
    "subject",
    "references",
    "output",
    "source",
    "promptPath",
    "promptSha256"
  ],
  "additionalProperties": false
}
