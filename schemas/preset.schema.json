{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Preset",
  "description": "A reusable set of style defaults. Presets never store an identity reference or a generated output (spec section 4.4).",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "styleReference": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^style\\.(png|jpg|webp)$"
            },
            "originalName": {
              "type": "string",
              "minLength": 1
            },
            "mimeType": {
              "type": "string",
              "enum": [
                "image/png",
                "image/jpeg",
                "image/webp"
              ]
            },
            "sizeBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "originalName",
            "mimeType",
            "sizeBytes",
            "sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "roleNotes": {
      "type": "object",
      "properties": {
        "style": {
          "type": "string"
        },
        "identity": {
          "type": "string"
        },
        "outfit": {
          "type": "string"
        },
        "equipment": {
          "type": "string"
        },
        "extra": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "promptConventions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "negativeConstraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "composition": {
      "type": "object",
      "properties": {
        "pose": {
          "type": "string"
        },
        "expression": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "aspectRatio": {
          "type": "string",
          "minLength": 1
        },
        "background": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": [
            "png",
            "jpg",
            "webp"
          ]
        }
      },
      "required": [
        "aspectRatio",
        "background",
        "format"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "createdAt",
    "updatedAt",
    "styleReference",
    "roleNotes",
    "promptConventions",
    "negativeConstraints",
    "composition",
    "output"
  ],
  "additionalProperties": false
}
