{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anchor",
  "description": "One version of a character anchor. Updating an anchor adds a version instead of overwriting one (spec section 4.5).",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "identityReference": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^identity\\.(png|jpg|webp)$"
        },
        "originalName": {
          "type": "string",
          "minLength": 1
        },
        "mimeType": {
          "type": "string",
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "originalName",
        "mimeType",
        "sizeBytes",
        "sha256"
      ],
      "additionalProperties": false
    },
    "approvedOutput": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^approved\\.(png|jpg|webp)$"
            },
            "originalName": {
              "type": "string",
              "minLength": 1
            },
            "mimeType": {
              "type": "string",
              "enum": [
                "image/png",
                "image/jpeg",
                "image/webp"
              ]
            },
            "sizeBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "originalName",
            "mimeType",
            "sizeBytes",
            "sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "identityDescription": {
      "type": "string"
    },
    "immutableTraits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mutableTraits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceJobId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9](?:[a-z0-9-]{0,22}[a-z0-9])?-\\d{3}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "createdAt",
    "identityReference",
    "approvedOutput",
    "identityDescription",
    "immutableTraits",
    "mutableTraits",
    "sourceJobId"
  ],
  "additionalProperties": false
}
